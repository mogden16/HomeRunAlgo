+            eligible_rows,
+            key=lambda row: (
+                -float(row["elite_precision"]),
+                -int(row["elite_sample_size"]),
+                float(row["elite_probability_floor"]) if row["elite_probability_floor"] is not None else -1.0,
+                int(row["elite_top_k"]) if row["elite_top_k"] is not None else 999,
