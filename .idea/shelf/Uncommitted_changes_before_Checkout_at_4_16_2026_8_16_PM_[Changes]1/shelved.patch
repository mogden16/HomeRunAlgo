+        "elite_sample_size": sample_size,
+        "elite_hr_count": hr_count,
+        "elite_precision": float(elite_rows[actual_col].mean()),
+        "elite_false_positives": int(sample_size - hr_count),
+        "elite_positive_rate": float(sample_size / len(scored_df)),
+    }
