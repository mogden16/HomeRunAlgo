+def _normalize_degrees(value: object) -> float | None:
+    if value is None or pd.isna(value):
+        return None
+    try:
+        normalized = float(value) % 360.0
+    except (TypeError, ValueError):
+        return None
+    return normalized if normalized >= 0 else normalized + 360.0
+
