+def _mlb_team_to_bref_code(team: object) -> str | None:
+    if pd.isna(team):
+        return None
+    team = str(team).upper()
+    mapping = {"AZ": "ARI", "CWS": "CHW", "KC": "KCR", "SD": "SDP", "SF": "SFG", "TB": "TBR", "WSH": "WSN", "OAK": "ATH"}
+    return mapping.get(team, team)
+
