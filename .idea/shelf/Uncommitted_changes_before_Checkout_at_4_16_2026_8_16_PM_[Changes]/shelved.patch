rkflow and does not run instantly.</p>\r\n        </div>\r\n      </details>\r\n    </main>\r\n  </div>\r\n\r\n  <dialog class=\"model-dialog\" id=\"model-explainer-dialog\">\r\n    <div class=\"model-dialog-head\">\r\n      <div>\r\n        <p class=\"eyebrow\">Model Guide</p>\r\n        <h2 id=\"model-explainer-title\">Metric guide</h2>\r\n        <p class=\"hero-text model-dialog-summary\" id=\"model-explainer-summary\"></p>\r\n      </div>\r\n      <button class=\"dialog-close\" id=\"model-explainer-close\" type=\"button\" aria-label=\"Close metric guide\">Close</button>\r\n    </div>\r\n    <div class=\"model-metric-list\" id=\"model-explainer-list\"></div>\r\n  </dialog>\r\n\r\n  <script src=\"./app.js\" defer></script>\r\n</body>\r\n</html>\r\n
